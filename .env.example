# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=3001

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/guardflex

# Strong random string for signing admin JWTs (required in production)
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated allowed frontend origins (strongly recommended in production)
# Example: https://www.example.com,https://example.com
# Leave unset in dev to allow any origin.
# CORS_ORIGIN=https://your-domain.com

# --- E-Mail (Kontaktformular-Benachrichtigung, optional) ---
# Ohne diese Variablen wird die Anfrage nur in der Datenbank gespeichert.
# Beispiel Microsoft 365 / Outlook: smtp.office365.com, Port 587, SMTP_SECURE=false
# Beispiel Gmail: App-Passwort nötig, smtp.gmail.com, Port 587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=website@example.com
# SMTP_PASS=your-smtp-password-or-app-password
# MAIL_FROM=website@example.com
# Empfänger (kommagetrennt). Standard: gleich wie SMTP_USER
# MAIL_TO=office@example.com,inbox@example.com
